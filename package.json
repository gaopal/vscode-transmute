{
  "name": "vscode-transmute",
  "displayName": "VSCode Transmute",
  "description": "Filter, Sort, Unique, Reverse, Align, CSV, Line Selection and more text Transformations",
  "version": "1.13.1",
  "icon": "transmute-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/gaopal/vscode-transmute"
  },
  "publisher": "gaopal",
  "engines": {
    "vscode": "^1.58.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:transmute.internal.command",
    "onCommand:transmute.JsonAsText",
    "onCommand:transmute.alignCSV",
    "onCommand:transmute.alignCursor",
    "onCommand:transmute.commands",
    "onCommand:transmute.compactCSV",
    "onCommand:transmute.copyToNewDocument",
    "onCommand:transmute.countUniqueLinesNewDocument",
    "onCommand:transmute.escapes",
    "onCommand:transmute.filter",
    "onCommand:transmute.filterAsNewDocument",
    "onCommand:transmute.joinLines",
    "onCommand:transmute.linesAsJSON",
    "onCommand:transmute.macroCreate",
    "onCommand:transmute.macroDelete",
    "onCommand:transmute.macroEdit",
    "onCommand:transmute.macroRepeat",
    "onCommand:transmute.macroRun",
    "onCommand:transmute.normalizeDiacriticalMarks",
    "onCommand:transmute.randomLines",
    "onCommand:transmute.randomSelections",
    "onCommand:transmute.reverseLines",
    "onCommand:transmute.reverseSelections",
    "onCommand:transmute.rotateBackwardSelections",
    "onCommand:transmute.rotateForwardSelections",
    "onCommand:transmute.selectHighlights",
    "onCommand:transmute.selectLines",
    "onCommand:transmute.selectionAsJSON",
    "onCommand:transmute.sortByLineLength",
    "onCommand:transmute.sortLines",
    "onCommand:transmute.sortSelections",
    "onCommand:transmute.splitLines",
    "onCommand:transmute.splitLinesBeforeDelimiter",
    "onCommand:transmute.splitLinesAfterDelimiter",
    "onCommand:transmute.trimLines",
    "onCommand:transmute.trimSelections",
    "onCommand:transmute.uniqueLines",
    "onCommand:transmute.uniqueLinesNewDocument",
    "onCommand:transmute.addChineseEnglishSpacing",
    "onCommand:transmute.addChineseEnglishSpacingInDocument",
    "onCommand:transmute.convertCurlToCode",
    "onCommand:transmute.encodingTools",
    "onCommand:transmute.convertDataFormat",
    "onCommand:transmute.openMenu"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "transmute.openMenu",
        "title": "Open Menu...",
        "category": "Transform"
      },
      {
        "command": "transmute.sortLines",
        "title": "Sort Lines",
        "category": "Transform"
      },
      {
        "command": "transmute.sortSelections",
        "title": "Sort Selections",
        "category": "Transform"
      },
      {
        "command": "transmute.filterAsNewDocument",
        "title": "Filter Lines As New Document...",
        "category": "Transform"
      },
      {
        "command": "transmute.internal.command",
        "title": "internal use only",
        "category": "Transform-Internal"
      },
      {
        "command": "transmute.filter",
        "title": "Filter Lines...",
        "category": "Transform"
      },
      {
        "command": "transmute.reverseLines",
        "title": "Reverse Lines",
        "category": "Transform"
      },
      {
        "command": "transmute.reverseSelections",
        "title": "Reverse Selections",
        "category": "Transform"
      },
      {
        "command": "transmute.alignCursor",
        "title": "Align To Cursor",
        "category": "Transform"
      },
      {
        "command": "transmute.alignCSV",
        "title": "Align CSV",
        "category": "Transform"
      },
      {
        "command": "transmute.compactCSV",
        "title": "Compact CSV",
        "category": "Transform"
      },
      {
        "command": "transmute.commands",
        "title": "List All Commands",
        "category": "Transform"
      },
      {
        "command": "transmute.uniqueLines",
        "title": "Unique Lines",
        "category": "Transform"
      },
      {
        "command": "transmute.uniqueLinesNewDocument",
        "title": "Unique Lines As New Document",
        "category": "Transform"
      },
      {
        "command": "transmute.sortByLineLength",
        "title": "Sort Lines By Length",
        "category": "Transform"
      },
      {
        "command": "transmute.countUniqueLinesNewDocument",
        "title": "Count Duplicate Lines As New Document",
        "category": "Transform"
      },
      {
        "command": "transmute.copyToNewDocument",
        "title": "Copy To New Document",
        "category": "Transform"
      },
      {
        "command": "transmute.selectLines",
        "title": "Select Full Lines (of all current selections)",
        "category": "Transform"
      },
      {
        "command": "transmute.selectHighlights",
        "title": "Select Highlights (make selections of all highlighted text)",
        "category": "Transform"
      },
      {
        "command": "transmute.linesAsJSON",
        "title": "Lines As JSON String Array",
        "category": "Transform"
      },
      {
        "command": "transmute.selectionAsJSON",
        "title": "Selection As JSON String",
        "category": "Transform"
      },
      {
        "command": "transmute.JsonAsText",
        "title": "JSON String As Text",
        "category": "Transform"
      },
      {
        "command": "transmute.trimLines",
        "title": "Trim Lines",
        "category": "Transform"
      },
      {
        "command": "transmute.trimSelections",
        "title": "Trim Selections",
        "category": "Transform"
      },
      {
        "command": "transmute.escapes",
        "title": "Encode / Decode ...",
        "category": "Transform"
      },
      {
        "command": "transmute.randomLines",
        "title": "Randomize Lines",
        "category": "Transform"
      },
      {
        "command": "transmute.randomSelections",
        "title": "Randomize Selections",
        "category": "Transform"
      },
      {
        "command": "transmute.joinLines",
        "title": "Join Lines...",
        "category": "Transform"
      },
      {
        "command": "transmute.splitLines",
        "title": "Split Lines...",
        "category": "Transform"
      },
      {
        "command": "transmute.splitLinesBeforeDelimiter",
        "title": "Split Lines Before...",
        "category": "Transform"
      },
      {
        "command": "transmute.splitLinesAfterDelimiter",
        "title": "Split Lines After...",
        "category": "Transform"
      },
      {
        "command": "transmute.rotateForwardSelections",
        "title": "Rotate Forward Selections",
        "category": "Transform"
      },
      {
        "command": "transmute.rotateBackwardSelections",
        "title": "Rotate Backward Selections",
        "category": "Transform"
      },
      {
        "command": "transmute.normalizeDiacriticalMarks",
        "title": "Normalize Diacritical Marks (remove accents)",
        "category": "Transform"
      },
      {
        "command": "transmute.addChineseEnglishSpacing",
        "title": "Add Chinese-English Spacing",
        "category": "Transform"
      },
      {
        "command": "transmute.addChineseEnglishSpacingInDocument",
        "title": "Add Chinese-English Spacing in Document",
        "category": "Transform"
      },
      {
        "command": "transmute.convertCurlToCode",
        "title": "Convert cURL to Code...",
        "category": "Transform"
      },
      {
        "command": "transmute.encodingTools",
        "title": "Encoding / Crypto Tools...",
        "category": "Transform"
      },
      {
        "command": "transmute.convertDataFormat",
        "title": "Convert Data Format...",
        "category": "Transform"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "transmute.sortLines",
          "when": "false"
        },
        {
          "command": "transmute.sortSelections",
          "when": "false"
        },
        {
          "command": "transmute.filterAsNewDocument",
          "when": "false"
        },
        {
          "command": "transmute.internal.command",
          "when": "false"
        },
        {
          "command": "transmute.filter",
          "when": "false"
        },
        {
          "command": "transmute.reverseLines",
          "when": "false"
        },
        {
          "command": "transmute.reverseSelections",
          "when": "false"
        },
        {
          "command": "transmute.alignCursor",
          "when": "false"
        },
        {
          "command": "transmute.alignCSV",
          "when": "false"
        },
        {
          "command": "transmute.compactCSV",
          "when": "false"
        },
        {
          "command": "transmute.commands",
          "when": "false"
        },
        {
          "command": "transmute.uniqueLines",
          "when": "false"
        },
        {
          "command": "transmute.uniqueLinesNewDocument",
          "when": "false"
        },
        {
          "command": "transmute.sortByLineLength",
          "when": "false"
        },
        {
          "command": "transmute.countUniqueLinesNewDocument",
          "when": "false"
        },
        {
          "command": "transmute.copyToNewDocument",
          "when": "false"
        },
        {
          "command": "transmute.selectLines",
          "when": "false"
        },
        {
          "command": "transmute.selectHighlights",
          "when": "false"
        },
        {
          "command": "transmute.linesAsJSON",
          "when": "false"
        },
        {
          "command": "transmute.selectionAsJSON",
          "when": "false"
        },
        {
          "command": "transmute.JsonAsText",
          "when": "false"
        },
        {
          "command": "transmute.trimLines",
          "when": "false"
        },
        {
          "command": "transmute.trimSelections",
          "when": "false"
        },
        {
          "command": "transmute.escapes",
          "when": "false"
        },
        {
          "command": "transmute.randomLines",
          "when": "false"
        },
        {
          "command": "transmute.randomSelections",
          "when": "false"
        },
        {
          "command": "transmute.joinLines",
          "when": "false"
        },
        {
          "command": "transmute.splitLines",
          "when": "false"
        },
        {
          "command": "transmute.splitLinesBeforeDelimiter",
          "when": "false"
        },
        {
          "command": "transmute.splitLinesAfterDelimiter",
          "when": "false"
        },
        {
          "command": "transmute.rotateForwardSelections",
          "when": "false"
        },
        {
          "command": "transmute.rotateBackwardSelections",
          "when": "false"
        },
        {
          "command": "transmute.normalizeDiacriticalMarks",
          "when": "false"
        },
        {
          "command": "transmute.addChineseEnglishSpacing",
          "when": "false"
        },
        {
          "command": "transmute.addChineseEnglishSpacingInDocument",
          "when": "false"
        },
        {
          "command": "transmute.convertCurlToCode",
          "when": "false"
        },
        {
          "command": "transmute.encodingTools",
          "when": "false"
        },
        {
          "command": "transmute.convertDataFormat",
          "when": "false"
        }
      ]
    },
    "languages": [
      {
        "id": "macro",
        "aliases": [
          "macro"
        ],
        "extensions": [
          ".macro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "macro",
        "scopeName": "source.macro",
        "path": "./macro.tmLanguage"
      }
    ]
  },
  "scripts": {
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p ./",
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./",
    "compile_common": "tsc -watch -p ../vscode-extension-common",
    "postinstall": "node ./node_modules/vscode/bin/install",
    "test": "node ./node_modules/vscode/bin/test",
    "test:refactor": "node --experimental-vm-modules --test --test-isolation=none test/refactor.test.cjs",
    "test:features": "node --test --test-isolation=none test/features.test.cjs",
    "test:all": "node --experimental-vm-modules --test --test-isolation=none test/refactor.test.cjs test/features.test.cjs test/encoding.test.cjs test/formats.test.cjs test/conversion-commands.test.cjs test/scope-menu.test.cjs",
    "test:tools": "node --test --test-isolation=none test/encoding.test.cjs test/formats.test.cjs test/conversion-commands.test.cjs"
  },
  "devDependencies": {
    "@types/vscode": "1.58.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "8.10.0",
    "prettier": "3.6.2",
    "@types/node": "^14.0.27",
    "typescript": "^3.9.7",
    "vscode": "^1.1.37"
  },
  "dependencies": {
    "md5": "2.3.0",
    "split-string": "6.1.0",
    "vscode-extension-common": "file:../vscode-extension-common",
    "curl-to-postmanv2": "1.8.7",
    "postman-code-generators": "1.9.0",
    "postman-collection": "4.0.0",
    "yaml": "2.9.1",
    "fast-xml-parser": "4.5.7",
    "@iarna/toml": "2.2.5",
    "ini": "3.0.1",
    "dot-properties": "1.1.2",
    "html-entities": "2.6.0",
    "natural-orderby": "2.0.3"
  }
}
